    "caps-marker",
    "dcaps",
    "grna-design",
    "plant-biotechnology",
    "bioinformatics"
  ],
  "homepage": "https://plantacrispai.netlify.app",
  "license": "SEE LICENSE IN LICENSE",
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "react-scripts": "5.0.1",
    "typescript": "^4.9.5"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "lint": "eslint src --ext .js"
  },
  "eslintConfig": {
    "extends": [
      "react-app"
    ]
  },
  "browserslist": {
